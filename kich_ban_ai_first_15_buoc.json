{
  "name": "Kịch bản E-commerce AI-First Toàn Diện (15 Bước Chuẩn)",
  "url": "https://www.saucedemo.com",
  "description": "Kịch bản vận hành trên nền tảng AI-First: Tự chữa lành phần tử, đối soát ngữ nghĩa thị giác và giám định pháp y tự động bằng Gemini Multimodal",
  "version": "2.0.0",
  "totalSteps": 15,
  "steps": [
    "(1) Điền \"standard_user\" vào ô \"Username\"",
    "(2) Điền \"secret_sauce\" vào ô \"Password\"",
    "(3) Bấm \"Login\"",
    "(4) Kiểm tra hiện chữ \"Products\"",
    "(5) Chọn sản phẩm thứ 1",
    "(6) Bấm \"Add to cart\"",
    "(7) Bấm \"shopping_cart_link\"",
    "(8) Kiểm tra hiện chữ \"Your Cart\"",
    "(9) Bấm \"Checkout\"",
    "(10) Điền \"Nguyen\" vào ô \"First Name\"",
    "(11) Điền \"Van A\" vào ô \"Last Name\"",
    "(12) Điền \"100000\" vào ô \"Zip/Postal Code\"",
    "(13) Bấm \"Continue\"",
    "(14) Bấm \"Finish\"",
    "(15) Kiểm tra hiện chữ \"Thank you for your order!\""
  ]
}
